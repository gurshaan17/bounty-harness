{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Independent evidence assessment; never approval authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "checks",
    "reportability",
    "waivers",
    "duplicate_ids",
    "follow_up"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "needs_evidence",
        "reject",
        "possible_duplicate",
        "recommend_human_review"
      ]
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_claim",
        "evidence_support",
        "alternative_explanations",
        "unsupported_impact",
        "reproducibility",
        "scope_policy",
        "duplicates",
        "missing_evidence"
      ],
      "properties": {
        "original_claim": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "conclusion",
            "artifact_ids"
          ],
          "properties": {
            "conclusion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "artifact_ids": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
