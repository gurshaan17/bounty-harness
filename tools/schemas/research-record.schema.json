{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "content"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "program",
        "asset",
        "component",
        "technology",
        "role",
        "functionality",
        "observation",
        "hypothesis",
        "investigation",
        "negative_result",
        "coverage",
        "evidence",
        "question",
        "queue_task",
        "decision",
        "technique_candidate"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "program-private",
        "report-safe",
        "high-sensitivity"
      ]
    },
    "basis": {
      "type": "string",
      "enum": [
        "observation",
        "inference"
      ]
    },
    "expires_at": {
      "type": "string",
      "maxLength": 128
    },
    "details": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128
          },
          "sha256": {
            "type": "string",
            "pattern": "[a-f0-9]{64}"
          }
        }
      }
    },
    "external_refs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "system",
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "system": {
            "type": "string",
            "enum": [
              "asset-graph",
              "traffic-corpus",
              "coverage"
            ]
          },
          "id": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    }
  }
}
